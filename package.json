{
  "name": "nosey",
  "version": "0.1.0",
  "description": "sniffs your workspace, suggests agent skills.",
  "bin": {
    "nosey": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "gallery": "tsx src/cli.tsx --screen gallery",
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "screenshot": "node --import tsx scripts/screenshot.tsx",
    "start": "node dist/cli.js",
    "prepare": "vp config"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "meow": "^14.1.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "ansi-to-html": "^0.7.2",
    "ink-testing-library": "^4.0.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
