{
  "name": "nosey",
  "version": "0.1.0",
  "description": "Workspace detection and agent skill suggestions with an Ink terminal shell",
  "bin": {
    "nosey": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets/nosey-brand-kit",
    "THIRD_PARTY_NOTICES.md",
    "schemas/registry",
    "registry-tools"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "vp pack",
    "lint": "vp lint",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:catalog && npm run test:map && npm run test:registry",
    "test:unit": "vp test run",
    "test:catalog": "node --import=tsx --test scripts/build-skills-catalog.test.mjs",
    "test:map": "node --import=tsx --test scripts/propose-skill-mappings.test.mjs",
    "skills-catalog": "node --experimental-strip-types scripts/build-skills-catalog.ts",
    "skills-map:propose": "node --experimental-strip-types scripts/propose-skill-mappings.ts",
    "screenshot": "node --import tsx scripts/screenshot.tsx",
    "start": "node dist/cli.js",
    "prepare": "vp config",
    "theme": "node scripts/theme.mjs",
    "theme:list": "node scripts/theme.mjs list",
    "theme:token": "node scripts/theme.mjs token",
    "theme:default": "node scripts/theme.mjs default",
    "record": "node --import tsx scripts/screenshot.tsx --video",
    "test:registry": "node --test registry-tools/*.test.mjs scripts/sync-registry-template.test.mjs",
    "docs:schema": "node scripts/build-schema-docs.mjs",
    "docs:schema:check": "node scripts/build-schema-docs.mjs --check",
    "registry:template:sync": "node scripts/sync-registry-template.mjs",
    "registry:package:check": "node --import=tsx scripts/check-registry-package.ts",
    "registry:template:check": "node scripts/sync-registry-template.mjs --check tests/fixtures/registry-template"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "meow": "^14.1.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "ajv": "^8.20.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
